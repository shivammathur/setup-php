{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": [
      "ES2025"
    ],
    "module": "Node20",
    "moduleResolution": "Node16",
    "noImplicitAny": true,
    "outDir": "./lib",
    "removeComments": true,
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "target": "ES2025",
    "types": [
      "node"
    ]
  },
  "exclude": ["__tests__", "lib", "node_modules"]
}
